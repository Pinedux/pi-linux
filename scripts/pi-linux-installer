#!/bin/bash
# Pi-Linux Installer Launcher (live desktop → disk install)
# Ofrece opciones para instalar Arch en disco o iniciar el escritorio live

set -e

# ============================================
# UTILIDADES TUI
# ============================================

if command -v whiptail &>/dev/null; then
    TUI="whiptail"
    ARGS=""
elif command -v dialog &>/dev/null; then
    TUI="dialog"
    ARGS="--stdout"
else
    TUI=""
fi

tui_msg() {
    local title="$1"
    local msg="$2"
    if [[ -n "$TUI" ]]; then
        $TUI $ARGS --title "$title" --msgbox "$msg" 20 70
    else
        echo ""
        echo "=== $title ==="
        echo "$msg"
        echo ""
        read -rp "Presiona Enter para continuar..."
    fi
}

tui_yesno() {
    local title="$1"
    local msg="$2"
    if [[ -n "$TUI" ]]; then
        $TUI $ARGS --title "$title" --yesno "$msg" 20 70
    else
        echo ""
        echo "=== $title ==="
        echo "$msg"
        read -rp "¿Continuar? [s/N]: " ans
        [[ "$ans" == "s" || "$ans" == "S" ]]
    fi
}

tui_menu() {
    local title="$1"
    local msg="$2"
    shift 2
    if [[ -n "$TUI" ]]; then
        $TUI $ARGS --title "$title" --menu "$msg" 20 70 12 "$@"
    else
        echo ""
        echo "=== $title ==="
        echo "$msg"
        local i=1
        while [[ $# -ge 2 ]]; do
            echo "  $i) $1 - $2"
            shift 2
            i=$((i+1))
        done
        read -rp "Selecciona: " sel
        echo "$sel"
    fi
}

# ============================================
# INICIAR ESCRITORIO LIVE
# ============================================

start_live_desktop() {
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  🖥️  Iniciando escritorio live..."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    # Ejecutar el script de setup del escritorio
    if [[ -f /usr/local/bin/pi-linux-live-desktop.sh ]]; then
        bash /usr/local/bin/pi-linux-live-desktop.sh
    fi

    # Iniciar SDDM
    echo "[*] Iniciando SDDM..."
    systemctl start sddm || true

    tui_msg "Escritorio Live" "SDDM se ha iniciado.\n\nSi necesitas volver a esta terminal, pulsa Ctrl+Alt+F1."
}

# ============================================
# MAIN
# ============================================

while true; do
    clear
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo -e "    \033[0;32m🥧  Pi-Linux Installer\033[0m"
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "  Este asistente instalará Arch Linux + Pi-Linux"
    echo "  en tu disco duro, o puedes probar el escritorio."
    echo ""
    echo "  ⚠️  ATENCIÓN: La instalación en disco borra datos."
    echo ""

    choice=$(tui_menu "Menú Principal" "Selecciona una opción:" \
        "install"   "Instalar Arch Linux + Pi-Linux (automático)" \
        "desktop"   "Iniciar escritorio live (Plasma) sin instalar" \
        "archinstall" "Ejecutar archinstall (instalador oficial Arch)" \
        "shell"     "Abrir terminal para instalación manual" \
        "reboot"    "Reiniciar el equipo" \
        "shutdown"  "Apagar el equipo")

    case "$choice" in
        install|1)
            DISK_INSTALLER="/usr/share/pi-linux/scripts/pi-linux-disk-installer.sh"
            if [[ -f "$DISK_INSTALLER" ]]; then
                echo ""
                echo "  🚀 Iniciando instalador de disco..."
                echo ""
                sleep 1
                bash "$DISK_INSTALLER"
                # Si el instalador termina, volver al menú
            else
                tui_msg "Error" "Instalador de disco no encontrado en $DISK_INSTALLER"
            fi
            ;;
        desktop|2)
            if tui_yesno "Escritorio Live" "Se iniciará el escritorio Plasma con autologin.\n\n¿Continuar?"; then
                start_live_desktop
            fi
            ;;
        archinstall|3)
            if command -v archinstall &>/dev/null; then
                echo ""
                echo "  Ejecutando archinstall..."
                echo ""
                archinstall
                echo ""
                echo "  ✅ archinstall finalizado."
                read -rp "  Presiona Enter para volver al menú..."
            else
                tui_msg "Error" "archinstall no encontrado."
            fi
            ;;
        shell|4)
            echo "  Abriendo terminal..."
            exec bash
            ;;
        reboot|5)
            if tui_yesno "Reiniciar" "¿Reiniciar el equipo ahora?"; then
                systemctl reboot
            fi
            ;;
        shutdown|6)
            if tui_yesno "Apagar" "¿Apagar el equipo ahora?"; then
                systemctl poweroff
            fi
            ;;
        *)
            echo "  Saliendo al shell..."
            break
            ;;
    esac
done

echo ""
echo "  Saliendo al shell de root. Escribe 'pi-linux-installer' para volver."
echo ""
