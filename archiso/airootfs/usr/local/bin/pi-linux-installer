#!/bin/bash
# Pi-Linux Installer Launcher (live desktop → disk install)
# Ofrece opciones para instalar Arch en disco

clear
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo -e "    \033[0;32m🥧  Pi-Linux Installer\033[0m"
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "  Este asistente instalará Arch Linux + Pi-Linux"
echo "  en tu disco duro."
echo ""
echo "  ⚠️  ATENCIÓN: Se borrarán los datos del disco seleccionado."
echo ""
echo "  Opciones:"
echo "    1) Ejecutar Pi-Linux TUI (instalador completo con rices)"
echo "    2) Ejecutar archinstall (instalador oficial de Arch)"
echo "    3) Abrir terminal para instalación manual"
echo "    4) Salir"
echo ""
read -rp "  Selecciona [1-4]: " choice

case "$choice" in
    1)
        PI_LINUX_TUI="/usr/share/pi-linux/scripts/tui.sh"
        if [[ -f "$PI_LINUX_TUI" ]]; then
            echo ""
            echo "  🚀 Iniciando Pi-Linux TUI..."
            echo ""
            sleep 1
            exec bash "$PI_LINUX_TUI"
        else
            echo ""
            echo "  ❌ Pi-Linux TUI no encontrado en $PI_LINUX_TUI"
            echo ""
            read -rp "  Presiona Enter para salir..."
        fi
        ;;
    2)
        if command -v archinstall &>/dev/null; then
            archinstall
            echo ""
            echo "  ✅ Instalación base completada."
            echo ""
            echo "  Para personalizar con Pi-Linux después del reinicio:"
            echo "    bash <(curl -sL https://raw.githubusercontent.com/Pinedux/pi-linux/main/scripts/tui.sh)"
            echo ""
            read -rp "  Presiona Enter para reiniciar..."
            systemctl reboot
        else
            echo "  ❌ archinstall no encontrado."
            read -rp "  Presiona Enter..."
        fi
        ;;
    3)
        echo "  Abriendo terminal..."
        echo "  Comando para instalar después: archinstall"
        exec bash
        ;;
    *)
        echo "  Saliendo..."
        exit 0
        ;;
esac
