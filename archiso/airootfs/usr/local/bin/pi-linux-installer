#!/bin/bash
# Pi-Linux Live Installer
# Este script corre automáticamente al arrancar la ISO live

set -e

REPO_URL="https://github.com/Pinedux/pi-linux.git"
INSTALL_DIR="/root/pi-linux"
TUI_SCRIPT="${INSTALL_DIR}/scripts/tui.sh"

# Banner
clear
echo ""
echo "    ____  _       __    _           __  _"
echo "   / __ \\(_)___ _/ /_  (_)_________/ /_(_)___  ___"
echo "  / /_/ / / __ '/ __ \\/ / ___/ ___/ __/ / __ \\/ _ \\"
echo " / ____/ / /_/ / / / / (__  |__  ) /_/ / / / /  __/"
echo "/_/   /_/\\__, /_/ /_/_/____/____/\\__/_/_/ /_/\\___/"
echo "        /____/"
echo ""
echo "    🥧  Pi-Linux Live Installer v2.0"
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Verificar conexión
echo "[*] Verificando conexión a internet..."
if ! ping -c 1 archlinux.org &>/dev/null; then
    echo ""
    echo "⚠  No hay conexión a internet."
    echo "   Conecta un cable Ethernet o configura WiFi con:"
    echo "      iwctl station wlan0 connect 'TU_WIFI'"
    echo ""
    read -rp "Pulsa ENTER para abrir una shell..."
    bash
    exit 1
fi
echo "[✓] Conexión OK"
echo ""

# Clonar repo
echo "[*] Descargando Pi-Linux desde GitHub..."
if [[ -d "$INSTALL_DIR" ]]; then
    rm -rf "$INSTALL_DIR"
fi

if git clone --depth 1 "$REPO_URL" "$INSTALL_DIR" 2>/dev/null; then
    echo "[✓] Repo clonado"
else
    echo "⚠  Falló la descarga."
    read -rp "Pulsa ENTER para shell..."
    bash
    exit 1
fi

echo ""

# Ejecutar TUI
if [[ -f "$TUI_SCRIPT" ]]; then
    chmod +x "$TUI_SCRIPT"
    bash "$TUI_SCRIPT"
else
    cd "$INSTALL_DIR"
    chmod +x pi-linux.sh
    bash pi-linux.sh
fi

# Post-instalación
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "¿Qué hacer ahora?"
echo "  1) Reiniciar"
echo "  2) Apagar"
echo "  3) Shell"
echo ""
read -rp "[1-3]: " post_action

case "$post_action" in
    1) systemctl reboot ;;
    2) systemctl poweroff ;;
    *) bash ;;
esac
